# ---- obrigatórias ----
DATABASE_URL=postgresql://ridely:ridely@localhost:5432/ridely
# Frase longa e aleatória (32 caracteres ou mais em produção).
JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
# Chave que cifra os CPFs no banco: 32 bytes em base64. Guarde em lugar seguro: sem ela os CPFs não podem ser lidos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CPF_CHAVE=

# ---- endereço e HTTPS ----
# Endereço público do sistema. Com https://, o cookie de sessão sai marcado como Secure.
APP_URL=http://localhost:5173
# Em produção o APP_URL precisa ser https://. Só para teste local em HTTP, defina PERMITIR_HTTP=true.
# PERMITIR_HTTP=true
# Force o cookie Secure (true) ou sem Secure (false). Vazio = segue o APP_URL.
# COOKIE_SEGURO=
# Atrás de um proxy reverso (nginx, Caddy): quantos proxies confiar para o IP do cliente.
# TRUST_PROXY=1
# HTTPS direto, sem proxy: caminhos dos arquivos PEM do certificado e da chave.
# TLS_CERT_FILE=/etc/ridely/fullchain.pem
# TLS_KEY_FILE=/etc/ridely/privkey.pem
# PORT=3000

UPLOAD_DIR=./uploads
ASSOCIACAO_NOME=Associação de Transporte Escolar
# Só para testes (ignorado em produção): fixa a data e a hora do servidor.
# RELOGIO_FALSO=2026-10-26T14:30:00-03:00
# Desliga o agendamento diário das rotinas automáticas (a execução manual continua disponível).
# ROTINAS_AUTOMATICAS=false

# E-mail. Vazio = os e-mails aparecem no terminal do back-end (modo desenvolvimento).
# Gmail: smtps://seu-email%40gmail.com:SENHA_DE_APP@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Ridely <seu-email@gmail.com>

# Usados só por `npm run seed` para criar o presidente inicial.
SEED_PRESIDENTE_NOME=
SEED_PRESIDENTE_EMAIL=
SEED_PRESIDENTE_SENHA=
